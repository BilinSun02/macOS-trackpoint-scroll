# macOS TrackPoint Scroll configuration
# Default location: ~/.config/macOS-trackpoint-scroll.conf

# false preserves the current/traditional wheel direction.
# true reverses both axes for natural/content-following scrolling.
natural_scroll=false

# Multiplier applied to reconstructed TrackPoint scroll output.
scroll_scale=8.0

# Suppress the adapter's ordinary middle-click while it is used for scrolling.
suppress_middle_click=true

# Base TrackPoint pointer sensitivity in seized mode.
pointer_speed=1.0

# Additional velocity-dependent gain. 0.0 disables acceleration completely.
# With 3.0, high-speed gain approaches 4x pointer_speed.
pointer_acceleration=0.0

# Raw speed in counts/ms at which half of the configured extra acceleration
# is active. This setting is ignored when pointer_acceleration=0.0.
pointer_acceleration_velocity=0.10

# Retrospectively undo a short, small terminal TrackPoint reversal.
# Disabled by default; live reversal is never delayed or suppressed.
rebound_filter=false
